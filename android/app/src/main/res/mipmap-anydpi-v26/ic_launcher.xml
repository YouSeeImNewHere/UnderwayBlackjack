<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: the launcher crops this to the phone's icon shape (circle,
     squircle...) instead of shrinking the square legacy icon onto a white
     disc. Background is the felt green; the foreground "21" sits inside
     the 66dp safe zone. monochrome is for Android 13 themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
