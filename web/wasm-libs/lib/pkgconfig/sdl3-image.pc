prefix=C:/Coding/CPP/UnderwayBlackjack/web/wasm-libs
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: SDL3_image
Description: image loading library for Simple DirectMedia Layer
Version: 3.4.6
Requires: sdl3 >= 3.4.0
Libs: -L${libdir} -lSDL3_image
Requires.private: 
Libs.private: -l$<TARGET_FILE_BASE_NAME:png_static> -l$<TARGET_FILE_BASE_NAME:zlibstatic>
Cflags: -I${includedir}
